{
  "manifest_version": 3,
  "name": "Episodio al azar — Netflix, HBO Max y Disney+",
  "version": "0.4.0",
  "description": "Sortea una temporada y un episodio de la serie abierta en Netflix, HBO Max o Disney+.",
  "permissions": ["activeTab", "scripting", "storage"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Episodio al azar", "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
